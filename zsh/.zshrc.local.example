# Machine-specific configuration
# Copy this file to ~/.zshrc.local and adjust for your machine.
# .zshrc.local is sourced at the end of .zshrc and is gitignored.

# .NET runtime location (varies by distro/install method)
# export DOTNET_ROOT="/usr/lib/dotnet"
# alias dotnet8="$HOME/.dotnet/dotnet8"

# SSHFS mounts
# alias mount-fi='sshfs NTE-FI-01-02:/home/pi ~/projects/frankenstein-dev -o idmap=user,uid=1000,gid=1000,allow_other,reconnect'

# Audio device override (e.g. bypass PipeWire routing)
# export TIDAL_AUDIO_DEVICE='alsa/sysdefault:CARD=S3'

# Lattice Diamond license
# export LATTICE_LICENSE_FILE="/home/espen/lscc/diamond/3.14/license/license.dat"

# Work aliases
# alias work-note="$HOME/.local/bin/work-note"
# alias excel="xleak -i"
