configuration {
    modes:                  "drun,run,window,ssh";
    show-icons:             true;
    icon-theme:             "Papirus";
    drun-display-format:    "{name}";
    display-drun:           " Apps";
    display-run:            " Run";
    display-window:         " Win";
    terminal:               "ghostty";
    font:                   "JetBrainsMono Nerd Font 12";
}

@theme "~/.config/rofi/themes/tokyonight.rasi"
