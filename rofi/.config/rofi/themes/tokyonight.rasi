/* Tokyo Night theme for rofi — matches sway/waybar/ghostty */
* {
    base:    #1a1b26;
    surface: #16161e;
    overlay: #414868;
    muted:   #565f89;
    text:    #c0caf5;
    blue:    #7aa2f7;
    cyan:    #7dcfff;
    red:     #f7768e;
    magenta: #bb9af7;

    background-color:  transparent;
    text-color:        @text;
}

window {
    width:           42%;
    border:          2px;
    border-color:    @blue;
    border-radius:   8px;
    background-color: @base;
    padding:         12px;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing:  10px;
}

inputbar {
    background-color: @surface;
    border-radius:    6px;
    padding:          8px 12px;
    spacing:          8px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @magenta;
}

entry {
    placeholder:       "Search…";
    placeholder-color: @muted;
}

message {
    background-color: @surface;
    border-radius:    6px;
    padding:          6px 10px;
}

listview {
    lines:        10;
    columns:      1;
    cycle:        true;
    dynamic:      true;
    scrollbar:    false;
    spacing:      4px;
    fixed-height: false;
}

element {
    padding:       6px 10px;
    border-radius: 6px;
    spacing:       8px;
}

element selected {
    background-color: @overlay;
    text-color:       @text;
}

element-icon {
    size:             1.2em;
    background-color: transparent;
    vertical-align:   0.5;
}

element-text {
    text-color:       inherit;
    background-color: transparent;
    vertical-align:   0.5;
}
